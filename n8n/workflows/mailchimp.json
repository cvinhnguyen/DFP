      ],
      "parameters": {
        "jsCode": "// The campaign's settings: the name the editors see, the subject line and\n// preview text the readers see, the sender, and the audience it goes to.\nconst r = $json;\nconst settings = { title: r.title || 'Newsletter', subject_line: r.subject || '', preview_text: r.preview_text || '' };\nif (r.from_name) settings.from_name = r.from_name;\nif (r.reply_to) settings.reply_to = r.reply_to;\nconst body = { settings };\nif (r.audience_id) body.recipients = { list_id: r.audience_id };\nreturn [{ json: { ...r, campaign_body: body } }];\n"
      }
