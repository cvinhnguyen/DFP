      "parameters": {
        "jsCode": "// What the dashboard asks for. Only these actions exist: nothing in this\n// workflow can send or schedule a campaign. Sending is a person's click in\n// Mailchimp.\nconst body = $json.body || {};\nconst action = String(body.action || '');\nconst server = String(body.server || '');\nconst known = ['account', 'upload', 'draft', 'status', 'test'];\nconst valid = known.includes(action) && /^[a-z]{2,4}\\d{1,3}$/.test(server);\nreturn [{ json: { ...body, action: valid ? action : 'invalid', base: `https://${server}.api.mailchimp.com/3.0` } }];\n"
      }
    },
    {
      "id": "5c83d48d-caa4-5c9f-925d-2a49c3a284da",
      "name": "Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 6,
        "output": "={{ ({ account: 0, upload: 1, draft: 2, status: 3, test: 4 })[$json.action] ?? 5 }}"
      }
    },
