      ],
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nfunction failed(r) {\n  const status = r.statusCode || 0;\n  const detail = String((r.body && (r.body.detail || r.body.title)) || r.statusMessage || r.error || '').slice(0, 300);\n  let code = 'mailchimp_failed';\n  if (status === 401) code = 'mailchimp_key';\n  else if (status === 403) code = 'mailchimp_forbidden';\n  else if (status === 404) code = 'mailchimp_missing';\n  else if (status === 400 && /list|audience/i.test(detail)) code = 'mailchimp_audience';\n  else if (status === 429) code = 'mailchimp_busy';\n  return { ok: false, code, status, message: `Mailchimp answered ${status || 'nothing'}`, detail };\n}\nconst good = r.statusCode >= 200 && r.statusCode < 300;\n\n// A draft can be changed. One deleted in Mailchimp is made again; one sent or\n// scheduled stays as it went out.\nconst plan = $('Draft plan').first().json;\nif (r.statusCode === 404) return [{ json: { ...plan, go: 'create' } }];\nif (!good) return [{ json: { ...failed(r), go: 'stop' } }];\nif (!['save', 'paused'].includes(r.body.status)) {\n  return [{ json: { ok: false, go: 'stop', code: 'mailchimp_not_draft', message: `The campaign is ${r.body.status}.`, detail: r.body.status } }];\n}\nreturn [{ json: { ...plan, go: 'update' } }];\n"
      }
