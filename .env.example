# Copy this file to .env and fill it in.
#
#   cp .env.example .env
#
# .env is in .gitignore and must never be committed.

# Database. Any password works for local development, just pick one.
POSTGRES_USER=dfp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=newsletter

# n8n encrypts saved credentials with this key. Generate one with:
#
#   openssl rand -hex 32
#
# Keep the value. If you change it, credentials already saved in n8n
# become unreadable and have to be entered again.
N8N_ENCRYPTION_KEY=

# Schedule triggers run on this timezone.
TIMEZONE=Europe/Helsinki

# How many hours of n8n execution history to keep. n8n stores the full
# payload of every run, including article text, so this is a retention
# setting and not only housekeeping. 720 hours is 30 days.
N8N_EXECUTION_RETENTION_HOURS=720

# Telegram bot token from BotFather. The capture workflow asks Telegram for
# new messages on a schedule, so no tunnel and no public address is needed.
# Revoke and reissue with /revoke in BotFather if it ever leaks.
TELEGRAM_BOT_TOKEN=

# Only needed if something later has to receive calls from the internet.
# The Telegram capture does not, because it polls.
WEBHOOK_URL=http://localhost:5678/

# Shared token that other workflows send to POST /webhook/ingest and
# POST /webhook/collect. The dashboard's "check now" button sends it too.
# Generate one with:
#
#   openssl rand -hex 24
#
# n8n/rebuild.sh creates the n8n credential from it.
INGEST_TOKEN=

# Mailchimp API key, optional. With it the dashboard can put a finished
# newsletter into Mailchimp as a draft campaign; nothing here ever sends.
# n8n/rebuild.sh copies it into the n8n credential "DFP Mailchimp", and no
# container is given it. Leave it empty to type the key into that credential
# in n8n instead. See docs/credentials.md before asking for one.
MAILCHIMP_API_KEY=

# Set to true once the dashboard is served over https, so its login cookie
# is never sent over plain http, and browsers are told to use https only.
# Leave it out on your own machine.
# COOKIE_SECURE=true

# The names the dashboard answers to, comma separated. Any other name is
# refused, so a web page that points its own name at your computer gets
# nothing. The default is this computer and the name n8n uses inside Docker;
# once the dashboard is hosted, add its public name.
# ALLOWED_HOSTS=localhost,127.0.0.1,dashboard,uutiskirje.example.fi

# Only behind a proxy (nginx, Caddy): the proxy's address, so the dashboard
# sees each visitor's own address and counts wrong passwords per visitor
# rather than for everyone at once.
# FORWARDED_ALLOW_IPS=172.18.0.1

# Only for running a second copy next to your own, for example to test a
# rebuild. Leave them out normally.
# CONTAINER_PREFIX=dfp
# DASHBOARD_PORT=8000
# N8N_PORT=5678
# POSTGRES_PORT=5432
