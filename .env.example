# Copy this file to .env and fill it in.
#
#   cp .env.example .env
#
# .env is in .gitignore and must never be committed.

# Database. Any password works for local development, just pick one.
POSTGRES_USER=dfp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=newsletter

# n8n encrypts saved credentials with this key. Generate one with:
#
#   openssl rand -hex 32
#
# Keep the value. If you change it, credentials already saved in n8n
# become unreadable and have to be entered again.
N8N_ENCRYPTION_KEY=

# Schedule triggers run on this timezone.
TIMEZONE=Europe/Helsinki

# How many hours of n8n execution history to keep. n8n stores the full
# payload of every run, including article text, so this is a retention
# setting and not only housekeeping. 720 hours is 30 days.
N8N_EXECUTION_RETENTION_HOURS=720

# Leave as is until you need the Telegram trigger. Then run a tunnel and
# put the public https URL here.
WEBHOOK_URL=http://localhost:5678/
