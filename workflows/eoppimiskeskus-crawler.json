    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst titles = data.titles || [];\nconst urls = data.urls || [];\nconst dates = data.dates || [];\n\nreturn titles.map((title, index) => ({\n  json: {\n    title: title,\n    url: urls[index] || \"\",\n    date: dates[index] || \"\"\n  }\n}));"
      },
