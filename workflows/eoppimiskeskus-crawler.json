    },
    {
      "parameters": {
        "jsCode": "const contentItems = $input.all();\nconst articleItems = $(\"Code in JavaScript\").all();\n\nreturn contentItems.map((item, index) => ({\n  json: {\n    title: articleItems[index]?.json?.title || \"\",\n    url: articleItems[index]?.json?.url || \"\",\n    date: articleItems[index]?.json?.date || \"\",\n    content: item.json.content || \"\"\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "id": "20197efb-d3aa-4c46-994c-09c5cea172e6",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n\n  let cleanContent = data.content || \"\";\n\n  cleanContent = cleanContent\n    .replace(/\\n/g, \" \")\n    .replace(/\\r/g, \" \")\n    .replace(/\\t/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\n  return {\n    json: {\n      title: data.title,\n      url: data.url,\n      date: data.date,\n      content: cleanContent\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
